{
  "name": "keboola-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for orchestrating AI agents that help a data analyst work with Keboola",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.0.0 <27"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "smoke:omniroute": "node scripts/smoke-omniroute.mjs",
    "vendor:sync": "node scripts/vendor-keboola.mjs",
    "vendor:update": "node scripts/vendor-keboola.mjs --latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build -w web && playwright test",
    "eval": "node scripts/eval.mjs",
    "eval:routing": "node scripts/eval-routing.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build -w web && npm run start -w server",
    "chat": "npm run chat -w server --",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web && tsc --noEmit -p e2e",
    "kbagent:snapshot": "node scripts/kbagent-snapshot.mjs",
    "build": "npm run build -w web",
    "check:first-start": "node scripts/first-start.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "server",
    "web"
  ]
}
